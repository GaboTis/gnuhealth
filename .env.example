# ============================================================
# GNU Health en Coolify — variables de entorno
# Copia este archivo a .env (uso local) o define las variables
# en el panel de Coolify (Environment Variables).
# ¡CAMBIÁ LAS CONTRASEÑAS!
# ============================================================

# --- PostgreSQL ---
DB_USER=gnuhealth
DB_PASSWORD=cambia-esta-clave-fuerte
DB_NAME=gnuhealth

# --- Primer superusuario "admin" de GNU Health/Tryton ---
TRYTON_ADMIN_PASSWORD=cambia-esta-otra-clave-fuerte
TRYTON_ADMIN_EMAIL=admin@example.com

# --- Puerto local de pruebas (no hace falta en Coolify) ---
SAO_PORT=8000
